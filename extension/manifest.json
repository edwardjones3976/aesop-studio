{
  "manifest_version": 3,
  "name": "Aesop Studio Browser Bridge",
  "version": "2.0.0",
  "description": "Connects your normal Chrome profile (and existing logins) to Aesop Studio over loopback with pairing-token authentication.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aesop Studio Browser Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content_pair.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
